{
  "name": "typer-site",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "The TypeR 3.0 website (direction B, Panel Break), Vite + React + TypeScript.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-news.mjs && node scripts/publish.mjs",
    "preview": "vite preview --outDir .. --port 4173 --strictPort",
    "test": "playwright test",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "image-size": "2.0.4",
    "marked": "18.1.2",
    "typescript": "5.7.2",
    "vite": "6.0.5"
  },
  "allowScripts": {
    "esbuild@0.24.0": true
  }
}
